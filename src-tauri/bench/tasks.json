[
  { "id": "open-notes", "say": "Open Notes", "setup": [["quit_app", { "name": "Notes" }]], "expect": [{ "tool": "open_app" }, { "front": "Notes" }] },
  { "id": "open-calculator", "say": "Open Calculator", "setup": [["quit_app", { "name": "Calculator" }]], "expect": [{ "front": "Calculator" }], "cleanup": [["quit_app", { "name": "Calculator" }]] },
  { "id": "open-weather", "say": "Open the Weather app", "expect": [{ "front": "Weather" }], "cleanup": [["quit_app", { "name": "Weather" }]] },
  { "id": "volume", "say": "Set the volume to 30", "expect": [{ "tool": "set_volume" }], "undo": true },
  { "id": "pause-music", "say": "Pause the music", "expect": [{ "tool": "media" }] },
  { "id": "web-search", "say": "Search the web for Rust ownership rules", "expect": [{ "tool": "web_search" }] },
  { "id": "open-site", "say": "Open apple.com", "expect": [{ "tool": "open_url" }] },
  { "id": "reminder", "say": "Remind me to call Sara tomorrow at 10", "expect": [{ "tool": "create_reminder" }], "undo": true },
  { "id": "note", "say": "Make a note called Bench groceries with milk and eggs", "expect": [{ "tool": "create_note" }], "undo": true },
  { "id": "event", "say": "Add an event called Bench sync tomorrow at 3 pm", "expect": [{ "tool": "create_event" }], "undo": true },
  { "id": "list-shortcuts", "say": "Which Shortcuts do I have?", "expect": [{ "tool": "list_shortcuts" }] },
  { "id": "find-file", "say": "Find my file named bench-invoice", "files": { "bench-invoice-acme.txt": "Invoice ACME\nTotal due: 4,250 EUR\n" }, "expect": [{ "tool": "find_files" }, { "answer": ["bench-invoice", "invoice"] }] },
  { "id": "read-file", "say": "What's the total due in my bench-invoice file?", "files": { "bench-invoice-acme.txt": "Invoice ACME\nTotal due: 4,250 EUR\n" }, "expect": [{ "tool": "read_file" }, { "answer": ["4,250", "4250", "4.250"] }] },
  { "id": "summarize-file", "say": "Read bench-list.txt in my XpuBench folder and tell me what's on it", "files": { "bench-list.txt": "apples\nbread\ncoffee\n" }, "expect": [{ "answer": ["apples"] }, { "answer": ["coffee"] }] },
  { "id": "open-file", "say": "Open the file bench-invoice-acme.txt", "files": { "bench-invoice-acme.txt": "Invoice ACME\n" }, "expect": [{ "tool": "open_file" }], "cleanup": [["quit_app", { "name": "TextEdit" }]] },
  { "id": "new-folder", "say": "Make a new folder called Bench Archive in my XpuBench folder", "expect": [{ "file": ["Bench Archive", true] }], "undo": true },
  { "id": "rename-file", "say": "Rename bench-draft.txt in XpuBench to bench-final.txt", "files": { "bench-draft.txt": "draft\n" }, "expect": [{ "file": ["bench-final.txt", true] }, { "file": ["bench-draft.txt", false] }], "undo": true },
  { "id": "move-file", "say": "Move bench-report.txt into the Bench Box folder in XpuBench", "files": { "bench-report.txt": "report\n", "Bench Box/.keep": "" }, "expect": [{ "file": ["Bench Box/bench-report.txt", true] }], "undo": true },
  { "id": "finder-downloads", "say": "Open my Downloads folder in Finder", "expect": [{ "front": "Finder" }] },
  { "id": "finder-show", "say": "Show the XpuBench folder in Finder", "files": { "bench-a.txt": "a\n" }, "expect": [{ "front": "Finder" }] },
  { "id": "calc-multiply", "say": "In Calculator, work out 12 times 7", "setup": [["quit_app", { "name": "Calculator" }]], "expect": [{ "window": ["Calculator", "84"] }], "cleanup": [["quit_app", { "name": "Calculator" }]] },
  { "id": "calc-add", "say": "Use Calculator to add 256 and 512", "setup": [["quit_app", { "name": "Calculator" }]], "expect": [{ "window": ["Calculator", "768"] }], "cleanup": [["quit_app", { "name": "Calculator" }]] },
  { "id": "safari-heading", "say": "Open example.com in Safari and tell me the heading on the page", "requires": ["Safari"], "expect": [{ "answer": ["example domain"] }] },
  { "id": "chrome-read", "say": "Open example.com in Chrome and tell me what the page says", "requires": ["Google Chrome"], "expect": [{ "answer": ["example", "documentation", "illustrative"] }] },
  { "id": "chrome-scroll", "say": "Open en.wikipedia.org/wiki/Macintosh in Chrome and scroll down a bit", "requires": ["Google Chrome"], "expect": [{ "tool": "scroll" }] },
  { "id": "search-and-open", "say": "Search the web for the Tauri framework and open its official website", "expect": [{ "answer": ["tauri"] }] },
  { "id": "maps-search", "say": "Open Maps and search for coffee", "expect": [{ "front": "Maps" }, { "window": ["Maps", "coffee"] }], "cleanup": [["quit_app", { "name": "Maps" }]] },
  { "id": "cursor-new-file", "say": "In Cursor, make a new untitled file", "requires": ["Cursor"], "expect": [{ "front": "Cursor" }, { "answer": ["new", "untitled", "file"] }] },
  { "id": "slack-channels", "say": "Open Slack and tell me the names of a few channels in my sidebar", "requires": ["Slack"], "expect": [{ "front": "Slack" }, { "answer": ["#", "channel", "general"] }] },
  { "id": "notes-and-volume", "say": "Open Notes and set the volume to 20", "expect": [{ "front": "Notes" }, { "tool": "set_volume" }], "undo": true },
  { "id": "two-apps", "say": "Open Calculator and then open Weather", "expect": [{ "tool": "open_app" }, { "answer": ["calculator"] }], "cleanup": [["quit_app", { "name": "Calculator" }], ["quit_app", { "name": "Weather" }]] }
]
